# Copy this file to ~/lab5.env then adapt the first 3 lines.
INITIALES=abc                        # your initials, lower case, no accents
LOCATION=francecentral               # an ALLOWED region (scripts/find-region.sh)
NODE_SIZE=Standard_B2als_v2          # AKS node size (scripts/find-region.sh)
RG=rg-lab5-$INITIALES
ACR_NAME=acrlab5${INITIALES}4821     # replace 4821 with 4 digits of your own
AKS_NAME=aks-lab5-$INITIALES
export MSYS_NO_PATHCONV=1            # Git Bash (Windows): prevents path conversion
